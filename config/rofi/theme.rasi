* {
    bg-col:       #1C2A1Eee;
    bg-col-light: #4E6B47;
    border-col:   #7D8C69;
    selected-col: #4E6B47;
    fg-col:       #F2EAD3;
    fg-col2:      #C7BEA7;
    grey:         #7D8C69;
}

window {
    background-color: @bg-col;
    border: 2px;
    border-color: @border-col;
    border-radius: 16px;
    width: 600px;
}

mainbox {
    background-color: transparent;
    children: [inputbar, listview];
}

inputbar {
    background-color: @bg-col-light;
    border-radius: 12px;
    padding: 8px 12px;
    margin: 12px;
    children: [prompt, entry];
}

prompt {
    text-color: @fg-col;
    padding: 0 8px 0 0;
}

entry {
    placeholder: "Search...";
    placeholder-color: @grey;
    text-color: @fg-col;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 4px;
    margin: 0 12px 12px 12px;
    cycle: true;
}

element {
    background-color: transparent;
    text-color: @fg-col2;
    border-radius: 10px;
    padding: 8px;
}

element selected {
    background-color: @selected-col;
    text-color: @fg-col;
}

element-icon {
    size: 24px;
    padding: 0 8px 0 0;
}

element-text {
    vertical-align: 0.5;
}
