{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 8,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "tray"
    ],

    "clock": {
        "format": "{:%H:%M}"
    },

    "battery": {
        "format": "{capacity}%"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪"
    },

    "pulseaudio": {
        "format": "{volume}%"
    }
}
