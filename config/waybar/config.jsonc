{
    "layer": "top",
    "position": "top",
    "height": 44,
    "spacing": 6,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "pulseaudio",
        "network",
        "battery",
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{name}"
    },

    "clock": {
        "format": "{:%H:%M}"
    },

    "pulseaudio": {
        "format": " {volume}%"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪"
    },

    "battery": {
        "format": " {capacity}%"
    },

    "tray": {
        "spacing": 8
    }
}
